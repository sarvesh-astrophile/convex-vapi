# @defaultRequired=false
# @defaultSensitive=true
# ---
ALCHEMY_PASSWORD=

# Sarvam STT/TTS key. Never goes to the browser.
# @required
SARVAM_API_KEY=

# Shared secret for Convex config lookups and call sync.
# @required
VOICE_SYNC_SECRET=

# Convex HTTP actions origin, e.g. https://<deployment>.convex.site
# @required
CONVEX_SITE_URL=

# Optional: OpenAI via Cloudflare AI Gateway.
# URL should be https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/compat
# @optional
CLOUDFLARE_AI_GATEWAY_URL=

# Optional: authenticated gateway token (cf-aig-authorization).
# @optional
CLOUDFLARE_AI_GATEWAY_TOKEN=

# Optional: OpenAI provider key (or use AI Gateway BYOK).
# @optional
OPENAI_API_KEY=
