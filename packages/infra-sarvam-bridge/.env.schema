# @defaultRequired=false
# @defaultSensitive=true
# ---
ALCHEMY_PASSWORD=

# Sarvam API key. Only the bridge Worker needs it; Convex never sees it.
# @required
SARVAM_API_KEY=

# Shared secret Vapi sends as the `x-vapi-secret` header.
# @required
SARVAM_BRIDGE_SECRET=

# HMAC key used to sign the per-assistant transcriber URL (agent, language,
# mode, channels, keyterms). Convex uses the same value at publish time.
# @required
SARVAM_BRIDGE_SIGNING_SECRET=
