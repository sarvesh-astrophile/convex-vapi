# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @public @type=url(matches="^(?!https?://example[.]convex[.])")
VITE_CONVEX_URL=

# @public @type=url(matches="^(?!https?://example[.]convex[.])")
VITE_CONVEX_SITE_URL=

# Cloudflare Agents voice runtime origin, e.g. https://voice-runtime.<stage>.workers.dev
# @public
# @optional
VITE_VOICE_RUNTIME_URL=

# Default agent to call from /voice when no ?agent= is present.
# @public
# @optional
VITE_VOICE_AGENT_ID=

# Default Vapi assistant used to prefill the outbound dialer at /voice.
# @public
# @optional
VITE_VAPI_ASSISTANT_ID=

# Default Vapi phone number id used to prefill the outbound dialer at /voice.
# @public
# @optional
VITE_VAPI_PHONE_NUMBER_ID=

# Vapi public key for in-browser voice agents (safe to expose).
# @public
# @optional
VITE_VAPI_PUBLIC_KEY=

# Vapi assistant used by the Paytm POS "Need help" voice agent.
# Defaults to 9df849b1-22a2-456b-b08e-e32aeaa26786 when unset.
# @public
# @optional
VITE_VAPI_PAYTM_ASSISTANT_ID=
